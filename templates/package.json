{
  "name": "channel-video-factory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Channel Video Factory scaffold (Stage 1) — Remotion + TypeScript video production pipeline.",
  "scripts": {
    "dev": "PRODUCER_PAGE_NAVIGATION_TIMEOUT_MS=${PRODUCER_PAGE_NAVIGATION_TIMEOUT_MS:-90000} npx --yes hyperframes@0.7.68 preview",
    "check:visual": "tsx src/pipeline/check-composition.ts",
    "check": "npm run check:visual && PRODUCER_PAGE_NAVIGATION_TIMEOUT_MS=${PRODUCER_PAGE_NAVIGATION_TIMEOUT_MS:-90000} npx --yes hyperframes@0.7.68 check --timeout 60000 --caption-zone \"x0=0;y0=.82;x1=1;y1=1;severity=error\"",
    "snapshot": "PRODUCER_PAGE_NAVIGATION_TIMEOUT_MS=${PRODUCER_PAGE_NAVIGATION_TIMEOUT_MS:-90000} npx --yes hyperframes@0.7.68 snapshot --no-end --timeout 20000",
    "render": "PRODUCER_PAGE_NAVIGATION_TIMEOUT_MS=${PRODUCER_PAGE_NAVIGATION_TIMEOUT_MS:-90000} npx --yes hyperframes@0.7.68 render",
    "studio": "remotion studio src/remotion/Root.tsx",
    "render:test": "remotion render src/remotion/Root.tsx Episode episodes/ep000-test/out/preview.mp4",
    "render:test:short": "remotion render src/remotion/Root.tsx Short shorts/sh000-test/out/preview.mp4",
    "validate": "tsx src/pipeline/validate-shots.ts",
    "parse-script": "tsx src/pipeline/parse-script.ts",
    "tts": "tsx src/pipeline/tts.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "qa": "tsx src/pipeline/qa.ts",
    "validate:short-format": "tsx src/pipeline/validate-short-format.ts",
    "validate:metadata": "tsx src/pipeline/validate-metadata.ts",
    "lint:script": "tsx src/pipeline/lint-script.ts",
    "validate:ledger": "tsx src/pipeline/validate-ledger.ts",
    "finalize": "tsx src/pipeline/finalize-episode.ts",
    "audio-mix": "tsx src/pipeline/audio-mix.ts",
    "check:audio": "tsx src/pipeline/check-audio.ts",
    "check:assets": "tsx src/pipeline/check-storyboard-assets.ts",
    "qa:frames": "tsx src/pipeline/qa-flat-frames.ts",
    "probe": "tsx src/pipeline/probe-frames.ts",
    "audio-cues": "tsx src/pipeline/build-audio-cues.ts",
    "usage": "tsx src/pipeline/usage-report.ts",
    "use": "tsx src/pipeline/use-episode.ts",
    "status": "tsx src/pipeline/set-status.ts",
    "typecheck:h3": "tsc -p tsconfig.h3.json --noEmit",
    "check:h3": "tsx src/pipeline/h3/check-h3-prompt.ts",
    "h3:pod": "tsx src/pipeline/h3/pod.ts",
    "h3:inspect": "tsx src/pipeline/h3/inspect-clips.ts",
    "h3:run": "tsx src/pipeline/h3/run-chapter.ts",
    "h3:reject": "tsx src/pipeline/h3/reject-clips.ts",
    "h3:subs": "python3 src/pipeline/h3/render-subs.py",
    "h3:audio-cues": "tsx src/pipeline/h3/build-audio-cues-h3.ts",
    "h3:assemble": "tsx src/pipeline/h3/assemble.ts",
    "h3:ambient": "tsx src/pipeline/h3/build-ambient.ts",
    "h3:preview": "tsx src/pipeline/h3/preview-chapter.ts",
    "check:readings": "tsx src/pipeline/check-readings.ts",
    "h3:figures": "tsx src/pipeline/h3/render-figures.ts",
    "next-videos": "tsx src/pipeline/next-videos.ts"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.485",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.485",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "playwright-core": "^1.62.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2"
  }
}

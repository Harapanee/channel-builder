{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H3 環境音の設定",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gainDb": {
      "type": "number",
      "minimum": -60,
      "maximum": 0,
      "description": "生成音を敷く量。0 は原音のまま。既定 -18"
    },
    "exclude": {
      "type": "array",
      "items": { "type": "string", "pattern": "^cL[0-9]+$" },
      "description": "音が破綻しているカット。無音に置き換える"
    },
    "perClip": {
      "type": "object",
      "propertyNames": { "pattern": "^cL[0-9]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "gainDb": { "type": "number", "minimum": -60, "maximum": 0 } },
        "required": ["gainDb"]
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://channel-video-factory.local/schemas/episode.schema.json",
  "title": "EpisodeFile",
  "description": "仕様書 §5.3。episodes/<epId>/episode.json(エピソード状態)。",
  "type": "object",
  "additionalProperties": false,
  "required": ["episodeId", "subject", "targetDurationSec", "status"],
  "properties": {
    "episodeId": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "targetDurationSec": { "type": "number", "exclusiveMinimum": 0 },
    "audioScheme": {
      "description": "音声の方式。既定 premix(master.mp3 1本)。legacy-tags はプリミックス移行前に完成した ep で、<audio> 直載せのまま check:audio を通すための明示宣言。",
      "enum": ["premix", "legacy-tags"]
    },
    "status": {
      "description": "工程の到達点。video-create が各工程完了時に npm run status で更新する(中断・再開の基盤)。factory-ui の server/progress.ts の工程レールと1対1で対応する。",
      "enum": [
        "researched",
        "scripted",
        "voiced",
        "storyboarded",
        "assets_ready",
        "implemented",
        "prechecked",
        "qa_passed",
        "reviewed",
        "packaged",
        "render_ready",
        "final"
      ]
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "studio-result",
  "description": "studio-finish が Studio(Claude in Chrome)で設定し、読み直して確かめた結果。episodes/<epId>/publish/studio-result.json",
  "type": "object",
  "required": ["videoId", "checkedAt", "items"],
  "additionalProperties": false,
  "definitions": {
    "item": {
      "type": "object",
      "required": ["status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["done", "failed", "pending", "skipped"] },
        "evidence": { "type": "string", "minLength": 1, "description": "設定後に読み直した Studio 画面の文言。pending/failed は理由" }
      }
    }
  },
  "properties": {
    "videoId": { "type": "string", "minLength": 1 },
    "checkedAt": { "type": "string", "minLength": 1 },
    "items": {
      "type": "object",
      "required": ["thumbTest", "monetization", "memberEarlyAccess", "endScreen"],
      "additionalProperties": false,
      "properties": {
        "thumbTest": { "$ref": "#/definitions/item" },
        "monetization": { "$ref": "#/definitions/item" },
        "memberEarlyAccess": { "$ref": "#/definitions/item" },
        "endScreen": { "$ref": "#/definitions/item" }
      }
    }
  }
}
